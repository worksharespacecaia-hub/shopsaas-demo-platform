{
  "project": "shopsaas-demo-brand-app",
  "storage": [
    {"asset_id": "firebase-brand-app-storage", "bucket": "shopsaas-demo-brand-app.appspot.example",
     "rules": [{"match": "/user-uploads/{allPaths=**}", "read": "if true", "write": "if request.auth != null"}],
